<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodMovement</AssemblyName>
    <RootNamespace>CodMovement</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The runtime ships CounterStrikeSharp.API; exclude it from output so the
         plugin folder contains only CodMovement.dll and its deps. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.260">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
