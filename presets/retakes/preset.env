# Retakes — B3none/cs2-retakes plugin drives round setup on defuse maps.
# Leave CS2_GAMEALIAS empty in .env; retakes runs on the base casual mode
# (game_type 0, game_mode 0) with the plugin in control.
export CS2_GAMETYPE="${CS2_GAMETYPE:-0}"
export CS2_GAMEMODE="${CS2_GAMEMODE:-0}"
export CS2_MAPGROUP="${CS2_MAPGROUP:-mg_active}"
export CS2_STARTMAP="${CS2_STARTMAP:-de_mirage}"
