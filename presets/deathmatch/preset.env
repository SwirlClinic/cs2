# Free-for-all style deathmatch on active-duty maps.
export CS2_GAMEALIAS="${CS2_GAMEALIAS:-deathmatch}"
export CS2_MAPGROUP="${CS2_MAPGROUP:-mg_active}"
export CS2_STARTMAP="${CS2_STARTMAP:-de_dust2}"
