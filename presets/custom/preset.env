# Custom preset template — copy this directory to presets/<your-mode>/ and
# set CS2_PRESET=<your-mode> in .env. Everything here is optional:
#   preset.env       gamemode env defaults (use "${VAR:-default}" so .env wins)
#   cfg/preset.cfg   cvars exec'd on every map load, before custom_overrides.cfg
#   configs/         files copied into counterstrikesharp/configs/ (overwritten
#                    when the active preset changes, left alone otherwise)
#   install.sh       one-time hook (e.g. download a plugin) run on preset switch
#
# export CS2_GAMEALIAS="${CS2_GAMEALIAS:-custom}"
# export CS2_STARTMAP="${CS2_STARTMAP:-de_dust2}"
# export CS2_ADDITIONAL_ARGS="${CS2_ADDITIONAL_ARGS:-+host_workshop_map <id>}"
