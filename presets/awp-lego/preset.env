# 24/7 AWP Lego — casual rules on the awp_lego_2 workshop map, AWP+Deagle only.
# Values here are defaults: anything set non-empty in .env wins.
export CS2_GAMEALIAS="${CS2_GAMEALIAS:-casual}"
export CS2_MAPGROUP="${CS2_MAPGROUP:-mg_active}"
export CS2_STARTMAP="${CS2_STARTMAP:-de_dust2}"
# awp_lego_2 by MARAFON — most-subscribed CS2 port of the classic map
export CS2_ADDITIONAL_ARGS="${CS2_ADDITIONAL_ARGS:-+host_workshop_map 3367343580}"
