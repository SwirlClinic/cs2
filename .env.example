# ---- Required ----
# Game server login token (GSLT) for App ID 730.
# Easiest: set STEAM_API_KEY below, then run: ./scripts/gslt.sh create
# Or generate manually at: https://steamcommunity.com/dev/managegameservers
# NOTE: tokens expire if unused for months — ./scripts/gslt.sh reset issues a
# fresh one for the same account.
SRCDS_TOKEN=

# ---- Server Identity ----
CS2_SERVERNAME=CS2 Server
CS2_PORT=27015
CS2_MAXPLAYERS=10
CS2_RCONPW=changeme
CS2_PW=
CS2_LAN=0
CS2_CHEATS=0
# Instance name — prefix for container names (cs2-server, cs2-mysql, ...).
# Set a unique value per instance when running several servers on one host
# (also give each its own CS2_PORT/TV_PORT/WP_WEB_PORT and clone directory).
CS2_INSTANCE=cs2

# ---- Game Mode ----
# Pick a preset; it sets the game mode, start map, cvars, and any plugins it
# needs. Available: awp-lego, casual, competitive, deathmatch, wingman,
# retakes, custom (see presets/ for what each does, and presets/custom for
# building your own).
CS2_PRESET=casual
#
# Advanced: any of these set non-empty here OVERRIDE the preset's defaults.
# Leave them empty to let the preset drive.
#   casual=type 0 mode 0 | competitive=type 0 mode 1 | wingman=type 0 mode 2
#   deathmatch=type 1 mode 2 | custom=type 3 mode 0
CS2_GAMEALIAS=
CS2_GAMETYPE=
CS2_GAMEMODE=
CS2_MAPGROUP=
CS2_STARTMAP=

# ---- Bots ----
# CS2_BOT_DIFFICULTY=  # 0=easy 1=normal 2=hard 3=expert
# CS2_BOT_QUOTA=       # number of bots
# CS2_BOT_QUOTA_MODE=  # fill or competitive

# ---- CSTV / SourceTV ----
TV_ENABLE=0
TV_PORT=27020
TV_AUTORECORD=0
TV_PW=

# ---- WeaponPaints / MySQL ----
WP_DB_HOST=mysql
WP_DB_PORT=3306
WP_DB_USER=weaponpaints
WP_DB_PASS=weaponpaints
WP_DB_NAME=weaponpaints

# ---- Web UI (skin picker / server manager) ----
# Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Public URL where the site is reachable
WP_SITE_URL=http://localhost:8080
# Host port for the web UI
WP_WEB_PORT=8080
# Skin language (skins_en, skins_fr, skins_de, skins_ru, etc.)
WP_SKIN_LANGUAGE=skins_en
# Session encryption key (at least 32 chars) — generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Public HTTPS (optional) ----
# Uncomment to run the Caddy reverse proxy (needs host ports 80/443 free and a
# Caddyfile pointing your domain at web:3000 — copy Caddyfile.example).
# COMPOSE_PROFILES=caddy

# ---- Misc ----
# Validate game files on every startup (slower, set 1 to repair)
STEAMAPPVALIDATE=0
# Re-download all plugins on next startup (resets to 0 behavior after)
FORCE_PLUGIN_REINSTALL=0
# GitHub token to avoid API rate limits during plugin install (optional)
GITHUB_TOKEN=
# Extra CLI args passed to cs2 binary (e.g. +host_workshop_map <workshop_id>)
CS2_ADDITIONAL_ARGS=
